#:import dp kivy.metrics.dp
#:set CARD_RADIUS dp(22)
#:set FIELD_RADIUS dp(12)
#:set PAGE_GAP dp(16)

# Centraliza título e ações em toda a altura da barra M2 (KivyMD 1.2).
<MDTopAppBar>:
    on_kv_post: app.center_top_app_bar(self)

# ---------- UI defaults (polish) ----------
<MDCard>:
    radius: [CARD_RADIUS] * 4
    elevation: 1

<MDRaisedButton>:
    size_hint_y: None
    height: dp(44)
    rounded_button: True
    elevation: 0

<MDRectangleFlatIconButton>:
    rounded_button: True

<MDTextField>:
    radius: [FIELD_RADIUS] * 4

<MDDialog>:
    radius: [CARD_RADIUS] * 4

<AppCard@MDCard>:
    padding: dp(14)
    radius: [CARD_RADIUS] * 4
    elevation: 1

<StatusBarSpacer@Widget>:
    # Afasta o conteúdo da barra de status do Android (app edge-to-edge)
    size_hint_y: None
    height: app.status_bar_height_dp

<SectionTitle@MDLabel>:
    font_style: "Subtitle1"
    bold: True
    size_hint_y: None
    height: self.texture_size[1] + dp(8)

<HintText@MDLabel>:
    theme_text_color: "Hint"
    font_style: "Caption"
    text_size: self.width, None
    size_hint_y: None
    height: self.texture_size[1] + dp(6)

<ActionRow@MDBoxLayout>:
    size_hint_y: None
    height: dp(44)
    spacing: dp(10)

<MoreItem>:
    icon: "chevron-right"
    IconLeftWidget:
        icon: root.icon

